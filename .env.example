# ══════════════════════════════════════════════════════════════════════════════
#  SYNQ — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SYNQ
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database (Operational) ───────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./synq.db
# Production (PostgreSQL — uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/synqdb

# ── FalkorDB (Graph Memory) ───────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=          # Leave empty for local dev (no auth)

# ── Ollama (Local AI) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
# Comma-separated list of models to register on startup:
OLLAMA_MODELS=llama3.2,llama3.2:1b,qwen2.5-coder:7b

# ── Google Gemini API (Cloud AI) ─────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ── AWS Bedrock (Optional — disabled by default) ──────────────────────────────
# Only activate if you have an AWS account and accept potential costs.
AWS_BEDROCK_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── CORS (Frontend URL) ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Artifact Storage ──────────────────────────────────────────────────────────
ARTIFACT_STORAGE=local               # local | s3_compatible
ARTIFACT_LOCAL_PATH=./artifacts

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Controls which providers are active (regardless of key presence).
ENABLE_OLLAMA=true
ENABLE_GEMINI=true
ENABLE_AWS_BEDROCK=false
